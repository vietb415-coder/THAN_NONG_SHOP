@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div style="max-width: 600px; margin: 50px auto; padding: 40px; text-align: center; font-family: Arial, sans-serif; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
    <div style="font-size: 72px; color: #2ea751; margin-bottom: 20px;">🎉</div>

    <h2 style="color: #2c3e50; margin-bottom: 15px; font-weight: bold; letter-spacing: 0.5px;">ĐẶT HÀNG THÀNH CÔNG!</h2>

    <p style="color: #4a5568; line-height: 1.6; margin-bottom: 30px; font-size: 16px;">
        Cảm ơn em đã ủng hộ nông sản sạch của <strong>Thần Nông Shop</strong>.<br />
        Đơn hàng của em đã được ghi nhận vào hệ thống Database và đang chờ bộ phận Admin xử lý.
    </p>

    <a asp-controller="Home" asp-action="Index" style="display: inline-block; background: #2ea751; color: white; padding: 12px 30px; text-decoration: none; border-radius: 4px; font-weight: bold; transition: background 0.2s; box-shadow: 0 2px 4px rgba(46, 167, 81, 0.3);">
        🏠 Quay lại trang chủ mua sắm
    </a>
</div>
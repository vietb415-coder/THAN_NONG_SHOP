@model IEnumerable<THAN_NONG_SHOP.Models.CartItem>

@{
    ViewData["Title"] = "Thông Tin Đặt Hàng";
}

<div style="max-width: 600px; margin: 30px auto; padding: 25px; border: 1px solid #e2e8f0; border-radius: 8px; font-family: Arial, sans-serif; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
    <h2 style="color: #2c3e50; text-align: center; margin-bottom: 25px;">📝 THÔNG TIN GIAO HÀNG</h2>

    <form asp-controller="Cart" asp-action="Checkout" method="post">
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px; font-weight: bold; color: #4a5568;">Họ và tên người nhận:</label>
            <input type="text" name=" CustomerName" value="@ViewBag.UserFullName" style="width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 4px;" required />
        </div>

        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px; font-weight: bold; color: #4a5568;">Số điện thoại:</label>
            <input type="text" name="shippingPhone" value="@ViewBag.UserPhone" style="width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 4px;" required />
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 5px; font-weight: bold; color: #4a5568;">Địa chỉ nhận hàng:</label>
            <textarea name="shippingAddress" rows="3" style="width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 4px;" required></textarea>
        </div>

        <div style="background: #edf2f7; padding: 15px; border-radius: 6px; margin-bottom: 20px; text-align: right;">
            <strong style="color: #4a5568;">Tổng số tiền cần trả:</strong>
            <span style="color: #e53e3e; font-size: 20px; font-weight: bold; margin-left: 10px;">
                @(ViewBag.Total != null ? ViewBag.Total.ToString("N0") : "0") đ
            </span>
        </div>

        <button type="submit" style="width: 100%; background: #2e5a1c; color: white; border: none; padding: 12px; font-size: 16px; font-weight: bold; border-radius: 6px; cursor: pointer; transition: background 0.3s ease; box-shadow: 0 4px 12px rgba(46,90,28,0.2);" onmouseenter="this.style.background='#1e3d12'" onmouseleave="this.style.background='#2e5a1c'">
            XÁC NHẬN ĐẶT HÀNG  
        </button>
    </form>
</div>
@model Microsoft.AspNetCore.Mvc.ModelBinding.ModelStateDictionary

@{
    ViewData["Title"] = "Đăng Nhập";
}

<div style="max-width: 400px; margin: 60px auto; padding: 30px; border: 1px solid #cbd5e0; border-radius: 8px; font-family: Arial, sans-serif; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
    <h3 style="text-align: center; color: #2c3e50; margin-bottom: 20px;">🔑 ĐĂNG NHẬP HỆ THỐNG</h3>

    <div asp-validation-summary="All" style="color: red; margin-bottom: 15px; font-size: 14px; list-style: none; padding: 0;"></div>

    <form asp-controller="Account" asp-action="Login" method="post">
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px; font-weight: bold; color: #4a5568;">Tài khoản:</label>
            <input type="text" name="username" style="width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 4px;" required />
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 5px; font-weight: bold; color: #4a5568;">Mật khẩu:</label>
            <input type="password" name="password" style="width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 4px;" required />
        </div>

        <button type="submit" style="width: 100%; background: #2ea751; color: white; border: none; padding: 12px; font-size: 16px; font-weight: bold; border-radius: 4px; cursor: pointer;">
            ĐĂNG NHẬP
        </button>
        <div style="display: flex; align-items: center; margin-bottom: 20px; font-family: 'Segoe UI', sans-serif;">
            <label style="display: inline-flex; align-items: center; cursor: pointer; user-select: none; color: #5c4033; font-size: 14px; font-weight: 500;">
                <input type="checkbox" name="RememberMe" value="true" style="accent-color: #2e5a1c; width: 18px; height: 18px; margin-right: 8px; cursor: pointer; border: 1px solid #d2b48c; border-radius: 4px;" />
                Duy trì đăng nhập trên thiết bị này
            </label>
        </div>
    </form>
</div>
@model Microsoft.AspNetCore.Mvc.ModelBinding.ModelStateDictionary

@{
    ViewData["Title"] = "Đăng Nhập";
}

<div style="max-width: 400px; margin: 60px auto; padding: 30px; background: #fdfbf7; border: 1px solid #eaddca; border-radius: 12px; font-family: 'Segoe UI', Arial, sans-serif; box-shadow: 0 8px 25px rgba(92,64,51,0.06);">
    <h3 style="text-align: center; color: #5c4033; margin-bottom: 25px; font-family: 'Playfair Display', serif; font-size: 24px; font-weight: bold;">🔑 ĐĂNG NHẬP HỆ THỐNG</h3>

    <div asp-validation-summary="All" style="color: #e53e3e; margin-bottom: 15px; font-size: 14px; list-style: none; padding: 0;"></div>

    <form asp-controller="Account" asp-action="Login" method="post">
        <div style="margin-bottom: 18px;">
            <label style="display: block; margin-bottom: 6px; font-weight: bold; color: #5c4033; font-size: 14px;">Tài khoản:</label>
            <input type="text" name="username" style="width: 100%; padding: 10px 12px; border: 1px solid #d2b48c; border-radius: 6px; box-sizing: border-box; background: #ffffff; color: #5c4033; font-size: 14px;" required />
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 6px; font-weight: bold; color: #5c4033; font-size: 14px;">Mật khẩu:</label>
            <input type="password" name="password" style="width: 100%; padding: 10px 12px; border: 1px solid #d2b48c; border-radius: 6px; box-sizing: border-box; background: #ffffff; color: #5c4033; font-size: 14px;" required />
        </div>

        <div style="display: flex; align-items: center; margin-bottom: 25px;">
            <label style="display: inline-flex; align-items: center; cursor: pointer; user-select: none; color: #5c4033; font-size: 14px; font-weight: 500;">
                <input type="checkbox" name="rememberMe" value="true" style="accent-color: #2e5a1c; width: 18px; height: 18px; margin-right: 8px; cursor: pointer; border: 1px solid #d2b48c; border-radius: 4px;" />
                Duy trì đăng nhập trên thiết bị này
            </label>
        </div>

        <button type="submit" style="width: 100%; background: #2e5a1c; color: white; border: none; padding: 12px; font-size: 16px; font-weight: bold; border-radius: 6px; cursor: pointer; transition: background 0.3s ease; box-shadow: 0 4px 12px rgba(46,90,28,0.2);" onmouseenter="this.style.background='#1e3d12'" onmouseleave="this.style.background='#2e5a1c'">
            ĐĂNG NHẬP
        </button>
    </form>
</div>
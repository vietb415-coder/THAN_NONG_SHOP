@model IEnumerable<THAN_NONG_SHOP.Models.Product>

@{
    ViewData["Title"] = "Thần Nông Shop - Trang Chủ";
}

<div style="max-width1200px;margin:0 auto; padding: 20px; font-family: Arial, sans-serif">  
    <h2 style="text-align:center;color: #2c3e50; margin-bottom:30px;">🌿 DANH SÁCH SẢN PHẨM</h2>
    <div style=" display: grid; grid-template-columns: repeat(auto-fill,minmax(250px,1fr));gap:25px   ">

        @foreach (var product in Model)
        {
           <div style="border: 1px solid #e2e8f0;border-radius:8px;overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); display:flex;flex-direction: column; background: #fff;">
                @if(!string.IsNullOrEmpty(product.ImageUrl))
            {
                <img src="@product.ImageUrl" alt="@product.Name" style="width: 100%; height: 200px; object-fit: cover;">
            }
            else{

                <div style="width: 100%; height: 200px; background: #bdc3c7; display: flex; align-items: center; justify-content: center; color: #7f8c8d;">
                    <span>Không có hình ảnh</span>
                </div>
            }
           
           </div>

           <div style="padding: 15px; flex-grow:1;display: flex; flex-direction: column;justify-content: space-between;">
              <div>
                  <span style="font-size:11px; color:#2ea751;text-transform:uppercase;font-weight:bold;background:#e6f7ec;padding: 2px 6px; border-radius:4px;">
                      @product.Category</span>
                    <h3 style="margin: 10px 0;font-size: 18px; color: #2d3748;">@product.Name</h3>
                    <p style="margin:0; color: #e53e3e; font-weight: bold; font-size:16px; ">@product.price.ToString("N0") VND  </p>

              </div>
              <div style=" margin-top:15px">
                  <a asp-action="Details" asp-route-id="@product.Id" style="display:block; text-align:center; background:#2c3e50; color: #fff; padding: 10px; text-decoration: none; border-radius: 4px;">

                      Xem Chi Tiết
                  </a>
              </div>
           </div>

        }
    </div>

</div>

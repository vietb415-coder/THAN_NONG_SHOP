@model IEnumerable<THAN_NONG_SHOP.Models.Category>

<ul class="nav-menu">
    <li class="nav-item"><a href="/">Trang Chủ</a></li>

    @if (Model != null)
    {
        foreach (var cat in Model)
        {
            <li class="nav-item">
                <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@cat.Id">@cat.Name</a>
            </li>
        }
    }

    <li class="nav-item"><a href="#">Về Chúng Tôi</a></li>
</ul>
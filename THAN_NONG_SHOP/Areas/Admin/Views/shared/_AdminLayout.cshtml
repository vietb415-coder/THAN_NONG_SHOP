<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Thần Nông Quản Trị</title>
    <style>
            :root {
                --bg-milky: #fdfbf7; 
                --primary-brown: #5c4033; 
                --gold-earth: #c5a059; 
                --leaf-green: #2e5a1c; 
            }

            body {
                margin: 0;
                font-family: 'Segoe UI', sans-serif;
                background: var(--bg-milky);
                color: #333;
            }


            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                background: var(--primary-brown);
                color: #fff;
                padding-top: 20px;
            }

            .sidebar-brand {
                padding: 20px;
                text-align: center;
                font-size: 20px;
                font-weight: bold;
                background-color: #1a252f;
                border-bottom: 1px solid #34495e;
            }

            .sidebar-menu {
                list-style: none;
                padding: 10px 0;
                flex: 1;
            }

                .sidebar-menu li a {
                    display: block;
                    padding: 12px 25px;
                    color: #dfd5ca;
                    text-decoration: none;
                    transition: 0.3s;
                }

                    .sidebar a:hover, .sidebar a.active {
                        background: rgba(255,255,255,0.08);
                        color: var(--gold-earth);
                        border-left: 4px solid var(--gold-earth);
                    }


            .main-container {
                flex: 1;
                display: flex;
                flex-direction: column;
            }

            .header {
                margin-left: 260px;
                height: 70px;
                background: #ffffff;
                display: flex;
                justify-content: space-between;
                align-items: center;
                justify-content: flex-end;
                padding: 0 20px;
            }

            .content {
                padding: 30px;
                flex: 1;
            }

            .footer {
                height: 40px;
                background-color: #fff;
                text-align: center;
                line-height: 40px;
                font-size: 14px;
                color: #7f8c8d;
                border-top: 1px solid #e0e0e0;
            }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="brand">THẦN NÔNG ADMIN</div>
        <a href="/Admin/Home/Index">Tổng Quan</a>
        <a href="/Admin/AdminOrders/Index">Quản Lý Đơn Hàng</a>
        <a href="/Admin/Product/Index"> Quản Lý Sản Phẩm</a>
        <a href="/Admin/Category/Index"> Quản Lý Danh Mục</a>
        <a href="/Admin/AdminUsers/Index"> Quản Lý Tài Khoản</a>
        <a href="/Home/Index" style="margin-top:50px; color:#ff9999;">Đăng xuất</a>
    </div>

    <div class="header">
        <h2 style="margin: 0; color: var(--primary-brown); font-size: 1.4rem; font-weight: 600;">
            @ViewBag.AdminPageTitle
        </h2>
        <div class="user-info" style="font-weight: 500; color: var(--leaf-green);">
            Chào, Quản trị viên 👑
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

</body>
</html>
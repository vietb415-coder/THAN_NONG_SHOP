<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Thần Nông Quản Trị</title>
    <style>
            :root {
                --bg-milky: #fdfbf7; 
                --primary-brown: #5c4033; 
                --gold-earth: #c5a059; 
                --leaf-green: #2e5a1c; 
            }

            body {
                margin: 0;
                font-family: 'Segoe UI', sans-serif;
                background: var(--bg-milky);
                color: #333;
            }

            /* Sidebar mới thanh lịch */
            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                background: var(--primary-brown);
                color: #fff;
                padding-top: 20px;
            }

                .sidebar .brand {
                    text-align: center;
                    font-size: 1.4rem;
                    font-weight: bold;
                    color: var(--gold-earth);
                    margin-bottom: 30px;
                    letter-spacing: 1px;
                }

                .sidebar a {
                    display: block;
                    padding: 12px 25px;
                    color: #dfd5ca;
                    text-decoration: none;
                    transition: 0.3s;
                }

                    .sidebar a:hover, .sidebar a.active {
                        background: rgba(255,255,255,0.08);
                        color: var(--gold-earth);
                        border-left: 4px solid var(--gold-earth);
                    }

            /* Header trên đầu */
            .header {
                margin-left: 260px;
                height: 70px;
                background: #ffffff;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 30px;
                box-shadow: 0 2px 5px rgba(0,0,0,0.02);
                border-bottom: 1px solid #eaddca;
            }

            .main-content {
                margin-left: 260px;
                padding: 40px 30px;
                background: var(--bg-milky);
                min-height: calc(100vh - 70px);
            }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="brand">THẦN NÔNG ADMIN</div>
        <a href="/Admin/Home/Index">Tổng Quan</a>
        <a href="/Admin/AdminOrders/Index">Quản Lý Đơn Hàng</a>
        <a href="/Admin/Product/Index"> Quản Lý Sản Phẩm</a>
        <a href="/Admin/Category/Index"> Quản Lý Danh Mục</a>
        <a href="/Admin/AdminUsers/Index"> Quản Lý Tài Khoản</a>
        <a href="/Home/Index" style="margin-top:50px; color:#ff9999;">Đăng xuất</a>
    </div>

    <div class="header">
        <h2 style="margin: 0; color: var(--primary-brown); font-size: 1.4rem; font-weight: 600;">
            @ViewBag.AdminPageTitle
        </h2>
        <div class="user-info" style="font-weight: 500; color: var(--leaf-green);">
            Chào, Quản trị viên 👑
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

</body>
</html>
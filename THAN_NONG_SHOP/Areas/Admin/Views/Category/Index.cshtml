@model IEnumerable<THAN_NONG_SHOP.Models.Category>

@{

    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Quảng lí danh mục";
}
<div style="padding:20px">

    <h2>Category List</h2>

    <table style="width:100%">

        <thead>

            <tr>

                <th>Name</th>

                <th>Description</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var category in Model)

            {

                <tr>

                    <td>@category.Name</td>

                    <td>@category.Description</td>

                </tr>

            }

        </tbody>

    </table></div>
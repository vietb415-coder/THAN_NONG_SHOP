@model IEnumerable<THAN_NONG_SHOP.Models.Category>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý danh mục";
}

<div style="padding:20px">
    <h2>Category List</h2>

    <div style="margin-bottom: 15px;">
        <a asp-area="Admin" asp-controller="Category" asp-action="Create"
           style="background: #23cc72; color: white; padding: 10px 15px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
            ➕ Thêm mới
        </a>
    </div>

    <table style="width:100%">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model THAN_NONG_SHOP.Models.Product // Đổi lại tên Model sản phẩm thực tế của em nếu khác

@{
    ViewData["Title"] = "Chỉnh Sửa Thông Tin Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Kế thừa layout quản trị chung
}

<div style="background: #ffffff; padding: 35px; border-radius: 12px; border: 1px solid #eaddca; box-shadow: 0 4px 25px rgba(92,64,51,0.03); max-width: 1000px; margin: 0 auto; font-family: 'Segoe UI', sans-serif;">

    <form asp-area="Admin" asp-controller="Product" asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

       
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px;">

           
            <div style="display: flex; flex-direction: column; gap: 18px;">
                <div>
                    <label style="display: block; font-weight: 600; color: #5c4033; margin-bottom: 8px; font-size: 14px;">Tên sản phẩm:</label>
                    <input type="text" asp-for="Name" style="width: 100%; padding: 10px 14px; border: 1px solid #d2b48c; border-radius: 6px; box-sizing: border-box; color: #5c4033; font-size: 14px;" required />
                </div>

                <div>
                    <label style="display: block; font-weight: 600; color: #5c4033; margin-bottom: 8px; font-size: 14px;">Danh mục sản phẩm:</label>
                    <select asp-for="categoryId" asp-items="ViewBag.Categories" style="width: 100%; padding: 10px 14px; border: 1px solid #d2b48c; border-radius: 6px; box-sizing: border-box; color: #5c4033; font-size: 14px; background-color: #fff;">
                        
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div>
                        <label style="display: block; font-weight: 600; color: #5c4033; margin-bottom: 8px; font-size: 14px;">Số lượng tồn kho:</label>
                        <input type="number" asp-for="stockQuantity" style="width: 100%; padding: 10px 14px; border: 1px solid #d2b48c; border-radius: 6px; box-sizing: border-box; color: #5c4033; font-size: 14px;" min="0" required />
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; color: #5c4033; margin-bottom: 8px; font-size: 14px;">Giá bán (đ):</label>
                        <input type="number" asp-for="price" style="width: 100%; padding: 10px 14px; border: 1px solid #d2b48c; border-radius: 6px; box-sizing: border-box; color: #5c4033; font-size: 14px;" min="0" required />
                    </div>
                </div>
            </div>

          
            <div style="display: flex; flex-direction: column; gap: 18px;">
                <div style="flex-grow: 1; display: flex; flex-direction: column;">
                    <label style="display: block; font-weight: 600; color: #5c4033; margin-bottom: 8px; font-size: 14px;">Mô tả sản phẩm:</label>
                    <textarea asp-for="Description" style="width: 100%; flex-grow: 1; min-height: 120px; padding: 12px; border: 1px solid #d2b48c; border-radius: 6px; box-sizing: border-box; color: #5c4033; font-size: 14px; resize: none;"></textarea>
                </div>

               
                <div style="background: #fbf9f6; border: 1px dashed #d2b48c; border-radius: 8px; padding: 15px; display: flex; align-items: center; gap: 20px;">
                    <div style="text-align: center;">
                        <span style="display: block; font-size: 12px; color: #8b5a2b; margin-bottom: 6px; font-weight: 500;">Ảnh hiện tại</span>
                        <img src="@Model.ImageUrl" style="width: 80px; height: 80px; object-fit: cover; border-radius: 6px; border: 1px solid #eaddca; background: #fff;" />
                    </div>
                    <div style="flex-grow: 1;">
                        <label style="display: block; font-weight: 600; color: #5c4033; margin-bottom: 6px; font-size: 13px;">Thay đổi ảnh mới:</label>
                        <input type="file" name="ImageFile" style="font-size: 13px; color: #718096;" />
                    </div>
                </div>
            </div>

        </div>
        <div style="display: flex; justify-content: flex-end; align-items: center; gap: 15px; border-top: 1px solid #f5f0e6; padding-top: 20px;">
            <a href="/Admin/Product" style="text-decoration: none; color: #a0aec0; font-size: 14px; font-weight: 500; transition: 0.2s;" onmouseenter="this.style.color='#5c4033'" onmouseleave="this.style.color='#a0aec0'">
                Hủy thay đổi
            </a>
            <button type="submit" style="background: #2e5a1c; color: #ffffff; border: none; padding: 12px 35px; font-size: 14px; font-weight: bold; border-radius: 6px; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 10px rgba(46,90,28,0.15);" onmouseenter="this.style.background='#1e3d12'; this.style.transform='translateY(-1px)'" onmouseleave="this.style.background='#2e5a1c'; this.style.transform='none'">
               CẬP NHẬT SẢN PHẨM
            </button>
        </div>
    </form>
</div>
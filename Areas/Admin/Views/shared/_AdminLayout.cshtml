<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Thần Nông Quản Trị</title>
    <style>
            :root {
                --bg-milky: #fdfbf7; 
                --primary-brown: #5c4033; 
                --gold-earth: #c5a059; 
                --leaf-green: #2e5a1c; 
            }

            body {
                margin: 0;
                font-family: 'Segoe UI', sans-serif;
                background: var(--bg-milky);
                color: #333;
            }

            .sidebar {
                width: 240px;
                background: var(--primary-brown);
                color: #fff;
                padding-top: 20px;
                flex-shrink: 0;
                display: flex;
                flex-direction: column;
                border-right: 1px solid rgba(255,255,255,0.05);
            }

            .sidebar-brand {
                padding: 10px 20px 20px 20px;
                text-align: center;
                font-size: 20px;
                font-weight: bold;
                font-family: 'Playfair Display', serif;
                color: #ffffff;
                border-bottom: 1px solid rgba(255,255,255,0.1);
                margin-bottom: 15px;
            }

            .sidebar a {
                display: block;
                padding: 12px 25px;
                color: #dfd5ca;
                text-decoration: none;
                transition: 0.3s;
                font-weight: 500;
            }

            .sidebar a:hover {
                background: rgba(255,255,255,0.08);
                color: #ffffff;
                border-left: 4px solid var(--leaf-green);
                padding-left: 21px;
            }

            .sidebar a.active {
                background: rgba(255,255,255,0.08);
                color: #ffffff;
                border-left: 4px solid var(--leaf-green);
                padding-left: 21px;
            }

            .main-container {
                flex: 1;
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            .header {
                height: 70px;
                background: #ffffff;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 30px;
                border-bottom: 1px solid #eaddca;
            }

            .content {
                padding: 30px;
                flex: 1;
                overflow-x: auto;
            }

            .app-icon {
                width: 1.1em;
                height: 1.1em;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
                vertical-align: -0.18em;
                margin-right: 0.4em;
            }
    </style>
</head>
<body>
    @await Html.PartialAsync("~/Views/Shared/_IconSprite.cshtml")

    <div style="display: flex; min-height: 100vh;">
        <div class="sidebar">
            <div class="sidebar-brand"><svg class="app-icon"><use href="#icon-leaf"></use></svg>THẦN NÔNG</div>
            <a href="/Admin/Home/Index"><svg class="app-icon"><use href="#icon-dashboard"></use></svg>Tổng Quan</a>
            <a href="/Admin/AdminOrders/Index"><svg class="app-icon"><use href="#icon-orders"></use></svg>Quản Lý Đơn Hàng</a>
            <a href="/Admin/Product/Index"><svg class="app-icon"><use href="#icon-product"></use></svg>Quản Lý Sản Phẩm</a>
            <a href="/Admin/Category/Index"><svg class="app-icon"><use href="#icon-folder"></use></svg>Quản Lý Danh Mục</a>
            <a href="/Admin/AdminUsers/Index"><svg class="app-icon"><use href="#icon-user"></use></svg>Quản Lý Tài Khoản</a>
            <a asp-area="" asp-controller="Home" asp-action="Index" style="margin-top: auto; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 15px;">← Về trang chủ</a>
            <a asp-area="" asp-controller="Account" asp-action="Logout" style="margin-bottom: 20px; color: #ff9999;"><svg class="app-icon"><use href="#icon-logout"></use></svg>Đăng xuất</a>
        </div>

        <div class="main-container">
            <div class="header">
                <h2 style="margin: 0; color: var(--primary-brown); font-size: 1.4rem; font-weight: 600;">
                    @ViewBag.AdminPageTitle
                </h2>
                <div class="user-info" style="font-weight: 500; color: var(--leaf-green);">
                    <svg class="app-icon"><use href="#icon-user"></use></svg>Chào, Quản trị viên
                </div>
            </div>

            <div class="content">
                @RenderBody()
            </div>
        </div>
    </div>

</body>
</html>

@model IEnumerable<THAN_NONG_SHOP.Models.PromotionReward>
@using THAN_NONG_SHOP.Models
@{ ViewData["Title"]="Quản lý khuyến mãi"; Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; var events=ViewBag.Events as IEnumerable<PromotionVoucherEvent> ?? []; }
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px"><div><h2 style="margin:0;color:#5c4033">Khuyến mãi & vòng quay</h2><p style="color:#718096">Hôm nay có <b>@ViewBag.TodaySpins</b> lượt quay. Tổng trọng số đang hoạt động: <b>@Model.Where(x=>x.IsActive&&x.WheelWeight>0&&(x.StockRemaining==null||x.StockRemaining>0)).Sum(x=>x.WheelWeight)</b>.</p></div></div>
@if(TempData["PromotionAdminSuccess"]!=null){<div style="padding:12px;background:#edf8e9;color:#285d20;margin-bottom:15px">@TempData["PromotionAdminSuccess"]</div>}@if(TempData["PromotionAdminError"]!=null){<div style="padding:12px;background:#fff0f0;color:#9c2525;margin-bottom:15px">@TempData["PromotionAdminError"]</div>}
<div style="display:grid;gap:15px">
@foreach(var item in Model){<form asp-action="Update" method="post" style="background:#fff;border:1px solid #e5dccd;border-radius:12px;padding:18px;display:grid;grid-template-columns:110px 1.2fr 1.3fr repeat(4,minmax(85px,.55fr));gap:10px;align-items:end"><input type="hidden" name="id" value="@item.Id"/><div><b style="color:#2e5a1c">@item.TemplateCode</b><small style="display:block;color:#888">ID @item.Id</small></div><label>Tiêu đề<input name="title" value="@item.Title" required/></label><label>Mô tả<input name="description" value="@item.Description" required/></label><label>Đơn tối thiểu<input name="minimumSubtotal" type="number" min="0" value="@item.MinimumSubtotal.ToString("0")"/></label><label>Tỷ lệ giảm<input name="percentageDiscount" type="number" min="0" max="1" step="0.01" value="@item.PercentageDiscount"/></label><label>Giảm cố định<input name="fixedDiscount" type="number" min="0" value="@item.FixedDiscount.ToString("0")"/></label><label>Giảm tối đa<input name="maximumDiscount" type="number" min="0" value="@item.MaximumDiscount.ToString("0")"/></label><label style="grid-column:2/4">Thông báo quyền lợi<input name="benefitMessage" value="@item.BenefitMessage" required/></label><label>Tên quà<input name="giftName" value="@item.GiftName"/></label><label>Trọng số<input name="wheelWeight" type="number" min="0" value="@item.WheelWeight"/></label><label>Tồn kho<input name="stockRemaining" type="number" min="0" value="@item.StockRemaining" placeholder="Không giới hạn"/></label><div style="display:flex;gap:9px;flex-wrap:wrap"><label><input type="checkbox" name="isActive" value="true" checked="@item.IsActive"/> Bật</label><label><input type="checkbox" name="isPublicOffer" value="true" checked="@item.IsPublicOffer"/> Công khai</label><label><input type="checkbox" name="isGift" value="true" checked="@item.IsGift"/> Quà</label><label><input type="checkbox" name="isFreeShipping" value="true" checked="@item.IsFreeShipping"/> Freeship</label></div><button type="submit" style="padding:10px;border:0;border-radius:7px;background:#2e5a1c;color:#fff;font-weight:700">Lưu</button></form>}
</div>
<h3 style="margin-top:30px;color:#5c4033">100 sự kiện voucher gần nhất</h3><div style="background:#fff;border-radius:10px;overflow:auto"><table style="width:100%;border-collapse:collapse"><thead><tr><th>Thời gian</th><th>Voucher ID</th><th>Tài khoản</th><th>Sự kiện</th><th>Đơn</th><th>Ghi chú</th></tr></thead><tbody>@foreach(var entry in events){<tr><td>@entry.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm:ss")</td><td>#@entry.VoucherId</td><td>@entry.UserName</td><td><b>@entry.EventType</b></td><td>@(entry.OrderId.HasValue?$"#{entry.OrderId}":"—")</td><td>@entry.Note</td></tr>}</tbody></table></div>
<style>label{font-size:11px;color:#695b52;font-weight:600}label>input:not([type=checkbox]){display:block;width:100%;box-sizing:border-box;margin-top:5px;padding:8px;border:1px solid #d8cbbb;border-radius:5px}th,td{padding:10px;border-bottom:1px solid #eee;text-align:left;font-size:12px}</style>

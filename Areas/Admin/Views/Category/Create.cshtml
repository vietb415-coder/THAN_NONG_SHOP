@model THAN_NONG_SHOP.Models.Category
  

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm mới danh mục";
}
<div style="padding: 20px;background: white; border-radius: 8px">


  <h2>Thêm mới danh mục</h2>
<hr />
<form method="post" asp-action="create">
        <div style="margin-bottom: 15px">
            <label style="display:block;margin-bottom:5px">Tên danh mục</label>
            <input asp-for="Name" style="width:100%;padding:8px" />
            <span asp-validation-for="Name" style="color:red;font-size:13px"></span>
        </div>
        <div style="margin-bottom">

            <label style="display:block;margin-bottom:5px">Mô tả</label>
            <textarea asp-for="Description" style="width:100%;padding:8px"></textarea>
            <span asp-validation-for="Description" style="color:red;font-size:13px"></span> 
        </div>
        <button type="submit" style="padding:10px 20px;background-color:#8b5a2b;color:white;border:none;border-radius:4px;cursor:pointer">Thêm mới</button>
        <a asp-action="Index" style="margin-left: 12px; color: #7f8c8d; text-decoration: none; font-weight: 600;">← Quay lại danh sách</a>
    </form> 
</div>

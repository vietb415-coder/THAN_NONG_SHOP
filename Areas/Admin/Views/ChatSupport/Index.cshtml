@model ChatAdminDashboard
@{ ViewBag.AdminPageTitle = "Hội thoại chăm sóc khách hàng"; Layout = "~/Areas/Admin/Views/shared/_AdminLayout.cshtml"; }
<style>.chat-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.chat-stat,.support-box{background:#fff;border:1px solid #e4ded4;border-radius:11px;padding:15px}.chat-stat strong{display:block;font-size:24px;color:#2e5a1c}.support-grid{display:grid;grid-template-columns:360px 1fr;gap:16px}.conversation-list,.transcript{max-height:650px;overflow:auto}.conversation-link{display:block;padding:12px;border-bottom:1px solid #eee;color:#333;text-decoration:none}.transcript p{padding:9px 11px;border-radius:9px;max-width:80%;white-space:pre-wrap}.transcript .user{background:#2e5a1c;color:#fff;margin-left:auto}.transcript .assistant{background:#f1f3ef}.message-meta{font-size:10px;color:#888}.resolve{border:0;background:#2e5a1c;color:#fff;border-radius:7px;padding:8px 12px}@@media(max-width:900px){.chat-stats{grid-template-columns:repeat(2,1fr)}.support-grid{grid-template-columns:1fr}}</style>
<div class="chat-stats"><div class="chat-stat"><strong>@Model.ConversationsToday</strong>Hôm nay</div><div class="chat-stat"><strong>@Model.NeedsHuman</strong>Chờ nhân viên</div><div class="chat-stat"><strong>@Model.Helpful</strong>Hữu ích</div><div class="chat-stat"><strong>@Model.NotHelpful</strong>Chưa hữu ích</div></div>
<div class="support-grid"><section class="support-box conversation-list"><h3>Hội thoại gần đây</h3>@foreach(var c in Model.Conversations){<a class="conversation-link" asp-action="Index" asp-route-id="@c.Id"><strong>@(c.UserName ?? "Khách vãng lai")</strong><br/><small>@c.LastMessageAt.ToLocalTime().ToString("dd/MM HH:mm") · @(c.NeedsHuman ? "⚠ Cần hỗ trợ" : "Tự động")</small></a>}</section><section class="support-box">@if(Model.Selected==null){<p>Chọn một hội thoại để xem nội dung.</p>}else{<h3>@(Model.Selected.UserName ?? "Khách vãng lai")</h3>@if(!string.IsNullOrWhiteSpace(Model.Selected.HandoffSummary)){<p><strong>Tóm tắt:</strong> @Model.Selected.HandoffSummary</p>}<div class="transcript">@foreach(var message in Model.Selected.Messages){<p class="@message.Role">@message.Content<br/><span class="message-meta">@message.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM") @(message.Helpful == true ? "· 👍" : message.Helpful == false ? "· 👎" : "")</span></p>}</div>@if(Model.Selected.NeedsHuman){<form asp-action="Resolve" method="post"><input type="hidden" name="id" value="@Model.Selected.Id"/><button class="resolve">Đánh dấu đã xử lý</button></form>}}</section></div>

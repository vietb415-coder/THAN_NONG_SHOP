@model List<ChatKnowledge>
@{ ViewBag.AdminPageTitle = "Kiến thức Chatbot"; Layout = "~/Areas/Admin/Views/shared/_AdminLayout.cshtml"; }
<style>.kb-grid{display:grid;grid-template-columns:minmax(280px,380px) 1fr;gap:22px}.kb-card{background:#fff;border:1px solid #e2ddd3;border-radius:12px;padding:18px}.kb-form label{display:block;font-weight:600;margin:10px 0 5px}.kb-form input,.kb-form textarea{width:100%;box-sizing:border-box;padding:9px;border:1px solid #cfc7bb;border-radius:7px}.kb-form button{margin-top:12px;padding:9px 15px;border:0;border-radius:7px;background:#2e5a1c;color:#fff}.kb-item{border-bottom:1px solid #eee8de;padding:13px 0}.kb-delete{background:#fff0f0!important;color:#b42318!important}@@media(max-width:800px){.kb-grid{grid-template-columns:1fr}}</style>
@if (TempData["Success"] != null) { <p style="color:#28731e">@TempData["Success"]</p> }
<div class="kb-grid"><section class="kb-card"><h3>Thêm nội dung mới</h3><form asp-action="Save" method="post" class="kb-form"><label>Nhóm</label><input name="Category" value="Chung" maxlength="80" required /><label>Tiêu đề / Câu hỏi</label><input name="Title" maxlength="120" required /><label>Nội dung chính xác</label><textarea name="Content" rows="7" maxlength="4000" required></textarea><label><input type="checkbox" name="IsActive" value="true" checked style="width:auto" /> Cho chatbot sử dụng</label><button type="submit">Lưu kiến thức</button></form></section>
<section class="kb-card"><h3>Kho kiến thức (@Model.Count)</h3>@foreach (var item in Model){<article class="kb-item"><form asp-action="Save" method="post" class="kb-form"><input type="hidden" name="Id" value="@item.Id" /><input name="Category" value="@item.Category" required /><input name="Title" value="@item.Title" required /><textarea name="Content" rows="3" required>@item.Content</textarea><label><input type="checkbox" name="IsActive" value="true" checked="@(item.IsActive ? "checked" : null)" style="width:auto" /> Đang sử dụng</label><button type="submit">Cập nhật</button></form><form asp-action="Delete" method="post" onsubmit="return confirm('Xóa kiến thức này?')"><input type="hidden" name="id" value="@item.Id" /><button class="kb-delete">Xóa</button></form></article>}</section></div>

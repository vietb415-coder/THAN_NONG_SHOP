@model THAN_NONG_SHOP.Models.Oder
@{ViewData["Title"]="Đã ghi nhận đơn hàng";}
<section class="commerce-panel"><h1>Đã ghi nhận đơn hàng #@Model.Id</h1>
<p>Trạng thái: <strong>@Model.Status</strong></p>
<p>@Model.CustomerName — @Model.PhoneNumber — @Model.Address</p>
<p>@ShippingMethods.Names.GetValueOrDefault(Model.ShippingMethod,Model.ShippingMethod) · Phí giao hàng @Model.ShippingFee.ToString("N0") đ</p>
<p>Tổng thanh toán: <strong>@Model.TotalPrice.ToString("N0") đ</strong></p>
@if(TempData["OrderMessage"]!=null){<p role="alert">@TempData["OrderMessage"]</p>}
@if(Model.Status==OrderStatus.AwaitingPayment && !string.IsNullOrEmpty(Model.PaymentUrl)){<a href="@Model.PaymentUrl">Tiếp tục thanh toán / Quét QR</a>}
@if(User.Identity?.IsAuthenticated==true){<p><a asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a></p>}
else{<p>Hãy lưu mã đơn để liên hệ cửa hàng. Bạn có thể xem lại đơn này trong phiên trình duyệt hiện tại.</p>}
<a asp-controller="Products" asp-action="Index">Tiếp tục mua sắm</a></section>

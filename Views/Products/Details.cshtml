@model THAN_NONG_SHOP.Models.ProductDetailsViewModel

@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
}

<div style="max-width: 950px; margin: 35px auto; padding: 0 20px; font-family: Arial, sans-serif;">
    <a asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@product.categoryId" style="display: inline-block; margin-bottom: 18px; color: #5c4033; text-decoration: none; font-weight: 700;">← Quay lại danh sách sản phẩm</a>

    <div style="display: grid; grid-template-columns: minmax(280px, 1fr) minmax(280px, 1fr); gap: 42px; align-items: start;">
        <div>
            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
            {
                <img src="@product.ImageUrl" alt="@product.Name" decoding="async" fetchpriority="high" width="600" height="470" style="width: 100%; max-height: 470px; object-fit: cover; border-radius: 12px; border: 1px solid #eaddca; background: #f7f5ef;" />
            }
            else
            {
                <div style="height: 400px; display: grid; place-items: center; border-radius: 12px; background: #f7f5ef; color: #a0aec0;">Chưa có hình ảnh</div>
            }
        </div>

        <section>
            <span style="color: #2e5a1c; font-weight: 700; text-transform: uppercase; font-size: 13px;">@product.Category?.Name</span>
            <h1 style="color: #2c3e50; margin: 10px 0; font-family: 'Playfair Display', serif;">@product.Name</h1>
            <div style="color:#d69e2e; font-size:18px; margin-bottom:8px;">★★★★★ <strong style="color:#34495e;">@(Model.Reviews.Count == 0 ? "Chưa có đánh giá" : $"{Model.AverageRating:0.0}/5 ({Model.Reviews.Count} đánh giá)")</strong></div>
            <div style="color: #e53e3e; font-size: 28px; font-weight: 700; margin-bottom: 20px;">@product.price.ToString("N0") đ</div>

            <p style="padding: 12px 15px; background: #f0fff4; color: #2e5a1c; border-radius: 7px;">
                Số lượng có sẵn: <strong>@product.stockQuantity</strong>
            </p>

            <h3 style="color: #34495e; margin: 25px 0 8px;">Mô tả sản phẩm</h3>
            <p style="color: #555; line-height: 1.7;">@product.Description</p>

            @if (TempData["CartError"] != null)
            {
                <div style="padding:12px 16px; margin-top:18px; color:#8a1c1c; background:#fff1f1; border:1px solid #efb4b4; border-radius:7px;">@TempData["CartError"]</div>
            }

            @if (product.stockQuantity > 0)
            {
                <form asp-area="" asp-controller="Cart" asp-action="AddToCart" method="post" style="margin-top: 28px;">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" style="width: 100%; border: 0; border-radius: 7px; padding: 13px; background: #2e5a1c; color: #fff; font-size: 16px; font-weight: 700; cursor: pointer;"><svg class="app-icon"><use href="#icon-cart"></use></svg>Thêm vào giỏ hàng</button>
                </form>
            }
            else
            {
                <button type="button" disabled style="width: 100%; margin-top: 28px; border: 0; border-radius: 7px; padding: 13px; background: #a0aec0; color: #fff; font-size: 16px; font-weight: 700;">Sản phẩm tạm hết hàng</button>
            }
        </section>
    </div>

    @if (!string.IsNullOrWhiteSpace(product.farmerStory))
    {
        <section style="margin-top: 42px; padding: 24px; background: #fdfbf7; border: 1px dashed #2e5a1c; border-radius: 10px;">
            <h3 style="margin-top: 0; color: #2e5a1c;"><svg class="app-icon"><use href="#icon-story"></use></svg>Câu chuyện từ nhà vườn</h3>
            <p style="color: #555; font-style: italic; line-height: 1.7; margin-bottom: 0;">“@product.farmerStory”</p>
        </section>
    }

    <section id="reviews" style="margin-top:42px; padding:24px; background:#fff; border:1px solid #e1e8df; border-radius:12px;">
        <h2 style="margin-top:0; color:#2c3e50;">Đánh giá từ khách hàng</h2>

        @if (TempData["ReviewError"] != null)
        {
            <div style="padding:12px; margin-bottom:14px; color:#8a1c1c; background:#fff1f1; border-radius:7px;">@TempData["ReviewError"]</div>
        }
        @if (TempData["ReviewSuccess"] != null)
        {
            <div style="padding:12px; margin-bottom:14px; color:#245719; background:#f0fff4; border-radius:7px;">@TempData["ReviewSuccess"]</div>
        }

        @if (Model.CanReview)
        {
            <form asp-controller="ProductReviews" asp-action="Save" method="post" style="padding:18px; margin-bottom:24px; background:#f8fbf7; border-radius:10px;">
                <input type="hidden" name="productId" value="@product.Id" />
                <label for="reviewRating" style="font-weight:700;">Số sao</label>
                <select id="reviewRating" name="rating" required style="display:block; margin:7px 0 12px; padding:9px;">
                    @for (var star = 5; star >= 1; star--)
                    {
                        <option value="@star" selected="@(Model.CurrentUserReview?.Rating == star)">@star sao</option>
                    }
                </select>
                <label for="reviewComment" style="font-weight:700;">Nhận xét</label>
                <textarea id="reviewComment" name="comment" minlength="3" maxlength="1000" required rows="4" style="display:block; width:100%; box-sizing:border-box; margin:7px 0 12px; padding:10px;">@Model.CurrentUserReview?.Comment</textarea>
                <button type="submit" style="padding:10px 18px; border:0; border-radius:7px; background:#2e5a1c; color:#fff; font-weight:700;">@(Model.CurrentUserReview == null ? "Gửi đánh giá" : "Cập nhật đánh giá")</button>
            </form>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <p style="padding:12px; background:#f7f5ef; border-radius:7px;">Bạn có thể đánh giá sau khi đơn chứa sản phẩm này đã hoàn thành.</p>
        }
        else
        {
            <p><a asp-controller="Account" asp-action="Login">Đăng nhập</a> bằng tài khoản đã mua hàng để đánh giá.</p>
        }

        @if (Model.Reviews.Count == 0)
        {
            <p style="color:#65727e;">Chưa có đánh giá nào cho sản phẩm này.</p>
        }
        @foreach (var review in Model.Reviews)
        {
            <article style="padding:16px 0; border-top:1px solid #edf0eb;">
                <div><strong>@review.UserName</strong> <span style="color:#d69e2e;">@($"{new string('★', review.Rating)}{new string('☆', 5 - review.Rating)}")</span></div>
                <small style="color:#718096;">✓ Đã mua hàng · @((review.UpdatedAt ?? review.CreatedAt).ToLocalTime().ToString("dd/MM/yyyy"))</small>
                <p style="margin-bottom:8px; white-space:pre-wrap;">@review.Comment</p>
                @if (Model.CurrentUserReview?.Id == review.Id)
                {
                    <form asp-controller="ProductReviews" asp-action="Delete" method="post">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <button type="submit" style="border:0; background:none; color:#c53030; cursor:pointer;">Xóa đánh giá</button>
                    </form>
                }
            </article>
        }
    </section>
</div>

<style>
    @@media (max-width: 720px) {
        div[style*="grid-template-columns: minmax(280px"] { grid-template-columns: 1fr !important; }
    }
</style>

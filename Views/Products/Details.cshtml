@model THAN_NONG_SHOP.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div style="max-width: 950px; margin: 35px auto; padding: 0 20px; font-family: Arial, sans-serif;">
    <a asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.categoryId" style="display: inline-block; margin-bottom: 18px; color: #5c4033; text-decoration: none; font-weight: 700;">← Quay lại danh sách sản phẩm</a>

    <div style="display: grid; grid-template-columns: minmax(280px, 1fr) minmax(280px, 1fr); gap: 42px; align-items: start;">
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" style="width: 100%; max-height: 470px; object-fit: cover; border-radius: 12px; border: 1px solid #eaddca; background: #f7f5ef;" />
            }
            else
            {
                <div style="height: 400px; display: grid; place-items: center; border-radius: 12px; background: #f7f5ef; color: #a0aec0;">Chưa có hình ảnh</div>
            }
        </div>

        <section>
            <span style="color: #2e5a1c; font-weight: 700; text-transform: uppercase; font-size: 13px;">@Model.Category?.Name</span>
            <h1 style="color: #2c3e50; margin: 10px 0; font-family: 'Playfair Display', serif;">@Model.Name</h1>
            <div style="color: #e53e3e; font-size: 28px; font-weight: 700; margin-bottom: 20px;">@Model.price.ToString("N0") đ</div>

            <p style="padding: 12px 15px; background: #f0fff4; color: #2e5a1c; border-radius: 7px;">
                Số lượng có sẵn: <strong>@Model.stockQuantity</strong>
            </p>

            <h3 style="color: #34495e; margin: 25px 0 8px;">Mô tả sản phẩm</h3>
            <p style="color: #555; line-height: 1.7;">@Model.Description</p>

            @if (Model.stockQuantity > 0)
            {
                <form asp-area="" asp-controller="Cart" asp-action="AddToCart" method="post" style="margin-top: 28px;">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" style="width: 100%; border: 0; border-radius: 7px; padding: 13px; background: #2e5a1c; color: #fff; font-size: 16px; font-weight: 700; cursor: pointer;"><svg class="app-icon"><use href="#icon-cart"></use></svg>Thêm vào giỏ hàng</button>
                </form>
            }
            else
            {
                <button type="button" disabled style="width: 100%; margin-top: 28px; border: 0; border-radius: 7px; padding: 13px; background: #a0aec0; color: #fff; font-size: 16px; font-weight: 700;">Sản phẩm tạm hết hàng</button>
            }
        </section>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.farmerStory))
    {
        <section style="margin-top: 42px; padding: 24px; background: #fdfbf7; border: 1px dashed #2e5a1c; border-radius: 10px;">
            <h3 style="margin-top: 0; color: #2e5a1c;"><svg class="app-icon"><use href="#icon-story"></use></svg>Câu chuyện từ nhà vườn</h3>
            <p style="color: #555; font-style: italic; line-height: 1.7; margin-bottom: 0;">“@Model.farmerStory”</p>
        </section>
    }
</div>

<style>
    @@media (max-width: 720px) {
        div[style*="grid-template-columns: minmax(280px"] { grid-template-columns: 1fr !important; }
    }
</style>
